---
import type { Lang } from '../data/portfolio';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (de: string, en: string) => lang === 'de' ? de : en;
// One sentence from the invented example letter, before and after the procedure.
// Numbers are the measured run over examples/letter_en.md in the repository.
const before = t(
  'Ich suche nicht irgendeine Stelle, sondern eine, in der die Abläufe noch entstehen.',
  'I am not applying for any operations role, but for one where the process is still being built.',
);
const after = t(
  'Ich suche eine Stelle, in der die Abläufe noch entstehen.',
  'I am applying for an operations role where the process is still being built.',
);
const rule = t('Gefunden: Gegenüberstellung „nicht X, sondern Y“', 'Found: contrast "not X, but Y"');
const steps = [
  [t('Regelprüfung', 'Rule check'), t('17 Regeln, immer gleich', '17 rules, always the same')],
  [t('Vorschlag 1', 'Suggestion 1'), t('KI-Modell ohne Vorwissen', 'AI model with no prior context')],
  [t('Vorschlag 2', 'Suggestion 2'), t('Modell eines anderen Herstellers', 'model by a different vendor')],
  [t('Regelprüfung', 'Rule check'), t('behält nur, was besser ist', 'keeps only what improves')],
];
---
<div class="demo prose-demo" data-panel="prose">
  <div class="demo-top"><span class="micro">{t('03 / TEXTPRÜFUNG', '03 / TEXT CHECK')}</span><span class="demo-tag">{t('Erfundener Beispielbrief', 'Invented example letter')}</span></div>
  <ol class="chain-steps" aria-label={t('Ablauf der Prüfung', 'Steps of the check')}>
    {steps.map(([name, note], i) => <li><span class="chain-node">{i + 1}</span><b>{name}</b><small>{note}</small></li>)}
  </ol>
  <div class="prose-pair">
    <div class="prose-block prose-before">
      <div class="file-label"><span>{t('vorher', 'before')}</span><span class="prose-count">FAIL 6 · WARN 4</span></div>
      <p><mark>{before}</mark></p>
      <small class="prose-rule">{rule}</small>
    </div>
    <div class="prose-block prose-after">
      <div class="file-label"><span>{t('nachher', 'after')}</span><span class="prose-count" data-countdown="6,4">FAIL 0 · WARN 0</span></div>
      <p>{after}</p>
      <small class="prose-rule">{t('Vorschlag 1, von der Regelprüfung bestätigt', 'Suggestion 1, confirmed by the rule check')}</small>
    </div>
  </div>
  <p class="demo-caption">{t('Ein Satz aus dem englischen Beispielbrief, hier übersetzt. Die Zähler stammen aus dem gemessenen Lauf über den ganzen Brief. Zwei Runden, fünf Vorschläge übernommen, keiner verworfen.', 'One sentence from the example letter. The counters come from the measured run over the whole letter. Two rounds, five suggestions applied, none rejected.')}</p>
</div>
