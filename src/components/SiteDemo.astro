---
import type { Lang } from '../data/portfolio';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (de: string, en: string) => lang === 'de' ? de : en;
// 8 real pages; the four redirect pages are not counted. Lighthouse: run of
// 16.09.2026 against the live address (see the Umsetzungsplan).
const facts = [
  ['8', t('Seiten, Deutsch und Englisch', 'pages, German and English')],
  ['0', t('Anfragen an Dritte beim Besuch', 'requests to third parties on a visit')],
  ['10', t('Tests gegen den fertigen Build', 'tests against the finished build')],
  ['3', t('Gestaltungsvarianten, eine Codebasis', 'design variants, one codebase')],
  ['100', t('Barrierefreiheit im Lighthouse-Lauf', 'accessibility in the Lighthouse run')],
];
const checks = [
  t('Kopf- und Fußzeile auf jeder Seite gleich', 'same header and footer on every page'),
  t('genau eine Hauptüberschrift je Seite', 'exactly one main heading per page'),
  t('Datenschutzerklärung beschreibt, was die Seite tut', 'privacy statement describes what the site does'),
  t('keine Platzhalter, keine Ersatzzeichen im Build', 'no placeholders, no replacement characters in the build'),
];
---
<div class="demo site-demo" data-panel="site">
  <div class="demo-top"><span class="micro">{t('05 / DIESE WEBSITE', '05 / THIS WEBSITE')}</span><span class="demo-tag">{t('Gemessen statt behauptet', 'Measured rather than claimed')}</span></div>
  <dl class="fact-grid">{facts.map(([n, label]) => <div><dt data-count>{n}</dt><dd>{label}</dd></div>)}</dl>
  <div class="prose-block">
    <div class="file-label"><span>tests/site-build.test.mjs</span><span class="prose-count">10 / 10</span></div>
    <ul class="check-list">{checks.map(c => <li><i class="tick" aria-hidden="true">✓</i>{c}</li>)}</ul>
  </div>
  <p class="demo-caption">{t('Alle Zahlen stammen aus dem Repository dieser Seite und lassen sich dort nachrechnen.', 'Every number comes from this site’s repository and can be checked there.')}</p>
</div>
