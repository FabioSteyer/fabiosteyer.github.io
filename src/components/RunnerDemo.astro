---
import type { Lang } from '../data/portfolio';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (de: string, en: string) => lang === 'de' ? de : en;
// Numbers from `python -m runner compare` in the repository (final rows).
const rows = [
  [t('Unumkehrbare Aktionen ohne Entscheidung', 'Irreversible actions without a decision'), '8', '0'],
  [t('Aufgaben doppelt erledigt', 'Tasks done twice'), '7–12', '0'],
  [t('Änderung der Sitzung erhalten', 'Session edit kept'), t('nein', 'no'), t('ja', 'yes')],
  [t('Befunde in der Übergabe', 'Findings in the handover'), '0', '8'],
  [t('Nach Freigabe ausgeführt', 'Executed after approval'), '–', '3'],
];
const flow = [
  [t('Besitz nehmen', 'Acquire'), t('belegt: überspringen', 'leased: skip')],
  [t('Arbeiten', 'Work'), t('unumkehrbar: vorlegen', 'irreversible: propose')],
  [t('Abschließen', 'Complete'), t('Prüfsummen, sonst Stopp', 'checksums, else stop')],
  [t('Übergeben', 'Hand over'), t('aus allen Abschlüssen', 'from all completions')],
];
---
<div class="demo runner-demo">
  <div class="demo-top"><span class="micro">{t('04 / ROUTINEN MIT FREIGABE', '04 / GATED ROUTINES')}</span><span class="demo-tag">{t('Erfundene Organisation', 'Invented organisation')}</span></div>
  <ol class="chain-steps" aria-label={t('Ablauf eines Laufs', 'Steps of a run')}>
    {flow.map(([name, note], i) => <li><span class="chain-node">{i + 1}</span><b>{name}</b><small>{note}</small></li>)}
  </ol>
  <table class="compare-table">
    <thead><tr><th scope="col">{t('Zwei Läufe, eine Sitzung, gleichzeitig', 'Two runs, one session, at once')}</th><th scope="col">{t('ohne', 'without')}</th><th scope="col">{t('mit', 'with')}</th></tr></thead>
    <tbody>{rows.map(([label, a, b]) => <tr><th scope="row">{label}</th><td class="cmp-bad">{a}</td><td class="cmp-good">{b}</td></tr>)}</tbody>
  </table>
  <p class="demo-caption">{t('Aus den Dateien gezählt, nicht aus den Meldungen der Akteure. Die Zahl der doppelt erledigten Aufgaben hängt vom Timing ab; die Tabelle im Repository sagt das.', 'Counted from the files, not from what the actors report. The number of tasks done twice depends on timing; the table in the repository says so.')}</p>
</div>
