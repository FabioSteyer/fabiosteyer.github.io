---
import Base from '../layouts/Base.astro';
---

<Base
  lang="de"
  title="Impressum — Fabio Steyer"
  description="Impressum."
  altHref="/en/legal-notice/"
  eyebrow="Rechtliches"
>
  <h1 class="page-title">Impressum</h1>

  <section class="doc-section" aria-labelledby="verantwortlich">
    <h2 id="verantwortlich" class="doc-section__label">Verantwortlich für den Inhalt</h2>
    <div class="doc-section__body">
      <p class="leading-relaxed">
        Fabio Steyer<br />
        <a href="mailto:steyerfabio@gmail.com">steyerfabio@gmail.com</a>
      </p>
    </div>
  </section>

  <section class="doc-section" aria-labelledby="zweck">
    <h2 id="zweck" class="doc-section__label">Zweck dieser Seite</h2>
    <div class="doc-section__body">
      <p class="leading-relaxed">
        Diese Seite ist ein privates Portfolio zur beruflichen Selbstdarstellung.
        Sie bietet keine Waren oder Dienstleistungen an, enthält keine Werbung und
        verfolgt keinen entgeltlichen Zweck.
      </p>
    </div>
  </section>

  <section class="doc-section" aria-labelledby="inhalte">
    <h2 id="inhalte" class="doc-section__label">Inhalte und Links</h2>
    <div class="doc-section__body">
      <p class="leading-relaxed">
        Die Inhalte dieser Seite wurden mit Sorgfalt erstellt. Für die Inhalte verlinkter
        externer Seiten sind deren Betreiber verantwortlich.
      </p>
    </div>
  </section>
</Base>
