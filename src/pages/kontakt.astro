---
import Base from '../layouts/Base.astro';
---

<Base
  lang="de"
  title="Kontakt — Fabio Steyer"
  description="Kontakt per E-Mail oder LinkedIn."
  altHref="/en/contact"
>
  <h1 class="text-3xl font-semibold tracking-tight">Kontakt</h1>

  <p class="mt-4 leading-relaxed">
    Für Rückfragen zu meinem Profil oder zu einer offenen Position erreichen Sie mich
    am schnellsten per E-Mail.
  </p>

  <dl class="mt-8 space-y-5">
    <div>
      <dt class="text-sm uppercase tracking-wide" style="color: var(--color-muted)">E-Mail</dt>
      <dd class="mt-1">
        <a href="mailto:steyerfabio@gmail.com" class="underline underline-offset-4" style="color: var(--color-accent)">steyerfabio@gmail.com</a>
      </dd>
    </div>
    <div>
      <dt class="text-sm uppercase tracking-wide" style="color: var(--color-muted)">LinkedIn</dt>
      <dd class="mt-1">
        <a href="https://www.linkedin.com/in/fabio-steyer-795a0a200" rel="noopener noreferrer" class="underline underline-offset-4" style="color: var(--color-accent)">linkedin.com/in/fabio-steyer-795a0a200</a>
      </dd>
    </div>
    <div>
      <dt class="text-sm uppercase tracking-wide" style="color: var(--color-muted)">Standort</dt>
      <dd class="mt-1">Berlin</dd>
    </div>
  </dl>

  <p class="mt-10 text-sm leading-relaxed" style="color: var(--color-muted)">
    Diese Seite verwendet kein Kontaktformular. Es gibt keinen Server, der Eingaben
    entgegennimmt, und keine Verarbeitung von Formulardaten.
  </p>
</Base>
