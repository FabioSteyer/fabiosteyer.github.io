---
import Base from '../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import fotoFabio from '../assets/foto-fabio-steyer.jpg';

// Vollaufloesung fuer den Klick auf das Foto: gleiche Quelle, nicht skaliert,
// JPEG mit Qualitaet 92 (Entscheid Fabio 16.09.2026: ein scharfes Foto statt der
// kleinen Vorschau). Metadaten werden beim Build entfernt.
const fotoVoll = await getImage({ src: fotoFabio, format: 'jpeg', quality: 92 });

const belege = [
  { fach: 'Python', beleg: 'Produktive Pipelines bei Cavator; alle drei Projekte unter Projekte', stufe: 'öffentlich belegbar' },
  { fach: 'Document Parsing', beleg: 'invoice-quote-reconciliation, gegen eine Wahrheitstabelle gemessen', stufe: 'öffentlich belegbar' },
  { fach: 'Nebenläufigkeit und Datenintegrität', beleg: 'concurrent-file-writes, Vergleichslauf mit und ohne Koordination', stufe: 'öffentlich belegbar' },
  { fach: 'Testdisziplin', beleg: '67 Tests über drei Projekte, inklusive Mehrprozessläufen', stufe: 'öffentlich belegbar' },
  { fach: 'Wissenschaftliche Datenauswertung', beleg: 'B.Sc.-Arbeit, Spektroskopie und Modellanpassung', stufe: 'öffentlich belegbar' },
  { fach: 'OCR', beleg: 'Rund 3.000 Rechnungen und Angebote bei Cavator, nicht öffentlich', stufe: 'praktisch genutzt' },
  { fach: 'LLM-Integration (Claude, OpenAI)', beleg: 'Eingebaut in eigene Pipelines im Betrieb; die Prüfkette in prose-check-chain ist gebaut, aufgezeichnete Modellantworten fehlen noch', stufe: 'praktisch genutzt' },
  { fach: 'Git', beleg: 'Drei Repositories mit nachvollziehbarer Historie', stufe: 'praktisch genutzt' },
  { fach: 'SQL', beleg: 'Eigene Übungen, im Aufbau', stufe: 'Lernstand' },
];
---

<Base
  lang="de"
  title="Über mich · Fabio Steyer"
  description="Werdegang, Fähigkeiten und deren Belegstufe."
  altHref="/en/about/"
  eyebrow="Fabio Steyer · Berlin"
>
  <div class="page-intro">
    <div>
      <h1 class="page-title">Über mich</h1>
      <p class="page-lede">
        Ich bin Physiker im Masterstudium an der TU Berlin und arbeite seit 2025 an der
        Schnittstelle von Datenanalyse und Prozessautomatisierung. Was mich an dieser Arbeit
        interessiert, ist die Entscheidung vor dem Code: welcher Schritt ein Skript braucht,
        welcher ein Sprachmodell, und welcher besser gar nicht automatisiert wird.
      </p>
    </div>
    <a
      href={fotoVoll.src}
      class="doc-frame doc-frame--link w-32 sm:w-44 shrink-0"
      target="_blank"
      rel="noopener"
      aria-label="Portraitfoto in voller Auflösung öffnen (neuer Tab)"
      title="Foto in voller Auflösung öffnen"
    >
      <Image
        src={fotoFabio}
        alt="Portraitfoto von Fabio Steyer"
        width={160}
        densities={[1, 2]}
        class="w-full h-auto"
      />
    </a>
  </div>

  <section class="doc-section" aria-labelledby="belege">
    <h2 id="belege" class="doc-section__label">Fähigkeiten und Belege</h2>
    <div class="doc-section__body">
      <p class="leading-relaxed" style="color: var(--color-muted)">
        Jede Zeile nennt, worauf sie sich stützt. „Lernstand" heißt: vorhanden, aber nicht
        durch ein Projekt belegt.
      </p>
      <div class="mt-5 overflow-x-auto">
        <table class="doc-table">
          <thead>
            <tr>
              <th>Fähigkeit</th>
              <th>Beleg</th>
              <th>Stufe</th>
            </tr>
          </thead>
          <tbody>
            {belege.map((b) => (
              <tr>
                <td>{b.fach}</td>
                <td style="color: var(--color-muted)">{b.beleg}</td>
                <td>
                  <span class:list={[
                    'doc-level',
                    b.stufe === 'öffentlich belegbar' && 'doc-level--proven',
                    b.stufe === 'Lernstand' && 'doc-level--learning',
                  ]}>{b.stufe}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="doc-section" aria-labelledby="ki">
    <h2 id="ki" class="doc-section__label">Zur KI-Unterstützung</h2>
    <div class="doc-section__body">
      <p class="leading-relaxed">
        Ich arbeite mit KI-Werkzeugen, auch beim Bau dieser Seite. Die fachlichen Entscheidungen,
        die Auswahl der Inhalte und deren Prüfung liegen bei mir.
      </p>
    </div>
  </section>
</Base>
