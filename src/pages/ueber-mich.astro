---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import fotoFabio from '../assets/foto-fabio-steyer.jpg';

const belege = [
  { fach: 'Python (Pandas, NumPy)', beleg: 'Produktive Pipelines bei Cavator, nicht öffentlich', stufe: 'praktisch genutzt' },
  { fach: 'Document Parsing und OCR', beleg: 'Rechnungs- und Angebotsabgleich, rund 3.000 Dokumente', stufe: 'praktisch genutzt' },
  { fach: 'LLM-Integration (Claude, OpenAI)', beleg: 'Eingebaut in eigene Pipelines im Betrieb', stufe: 'praktisch genutzt' },
  { fach: 'Wissenschaftliche Datenauswertung', beleg: 'B.Sc.-Arbeit, Spektroskopie und Modellanpassung', stufe: 'öffentlich belegbar' },
  { fach: 'SQL', beleg: 'Studienprojekte, im Aufbau', stufe: 'Lernstand' },
  { fach: 'Git', beleg: 'Studienprojekte und eigene Arbeit', stufe: 'Lernstand' },
];
---

<Base
  lang="de"
  title="Über mich — Fabio Steyer"
  description="Werdegang, Fähigkeiten und deren Belegstufe."
  altHref="/en/about"
>
  <div class="sm:flex sm:items-start sm:gap-8">
    <div class="flex-1">
      <h1 class="text-3xl font-semibold tracking-tight">Über mich</h1>
      <p class="mt-4 leading-relaxed max-w-2xl">
        Ich bin Physiker im Masterstudium an der TU Berlin und arbeite seit 2025 an der
        Schnittstelle von Datenanalyse und Prozessautomatisierung. Was mich an dieser Arbeit
        interessiert, ist die Entscheidung vor dem Code: welcher Schritt ein Skript braucht,
        welcher ein Sprachmodell, und welcher besser gar nicht automatisiert wird.
      </p>
    </div>
    <div class="doc-frame mt-6 sm:mt-1 w-32 sm:w-40 shrink-0">
      <Image
        src={fotoFabio}
        alt="Portraitfoto von Fabio Steyer"
        width={160}
        densities={[1, 2]}
        class="w-full h-auto"
      />
    </div>
  </div>

  <section class="doc-section" aria-labelledby="belege">
    <h2 id="belege" class="doc-section__label">Fähigkeiten und Belege</h2>
    <div class="doc-section__body">
      <p class="leading-relaxed" style="color: var(--color-muted)">
        Jede Zeile nennt, worauf sie sich stützt. „Lernstand" heißt: vorhanden, aber nicht
        durch ein Projekt belegt.
      </p>
      <div class="mt-5 overflow-x-auto">
        <table class="doc-table">
          <thead>
            <tr>
              <th>Fähigkeit</th>
              <th>Beleg</th>
              <th>Stufe</th>
            </tr>
          </thead>
          <tbody>
            {belege.map((b) => (
              <tr>
                <td>{b.fach}</td>
                <td style="color: var(--color-muted)">{b.beleg}</td>
                <td>
                  <span class:list={[
                    'doc-level',
                    b.stufe === 'öffentlich belegbar' && 'doc-level--proven',
                    b.stufe === 'Lernstand' && 'doc-level--learning',
                  ]}>{b.stufe}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="doc-section" aria-labelledby="ki">
    <h2 id="ki" class="doc-section__label">Zur KI-Unterstützung</h2>
    <div class="doc-section__body">
      <p class="leading-relaxed">
        Ich arbeite mit KI-Werkzeugen, auch beim Bau dieser Seite. Die fachlichen Entscheidungen,
        die Auswahl der Inhalte und deren Prüfung liegen bei mir.
      </p>
    </div>
  </section>
</Base>
