---
import Base from '../../layouts/Base.astro';
---

<Base
  lang="en"
  title="Contact — Fabio Steyer"
  description="Contact by email or LinkedIn."
  altHref="/kontakt"
>
  <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>

  <p class="mt-4 leading-relaxed max-w-2xl">
    For questions about my profile or an open position, email is the fastest way to reach me.
  </p>

  <dl class="mt-8 space-y-5 max-w-2xl">
    <div class="border-t pt-3" style="border-color: var(--color-line)">
      <dt class="doc-meta-label">Email</dt>
      <dd class="mt-1">
        <a href="mailto:steyerfabio@gmail.com" class="underline underline-offset-4" style="color: var(--color-accent)">steyerfabio@gmail.com</a>
      </dd>
    </div>
    <div class="border-t pt-3" style="border-color: var(--color-line)">
      <dt class="doc-meta-label">LinkedIn</dt>
      <dd class="mt-1">
        <a href="https://www.linkedin.com/in/fabio-steyer-795a0a200" rel="noopener noreferrer" class="underline underline-offset-4" style="color: var(--color-accent)">linkedin.com/in/fabio-steyer-795a0a200</a>
      </dd>
    </div>
    <div class="border-t pt-3" style="border-color: var(--color-line)">
      <dt class="doc-meta-label">Location</dt>
      <dd class="mt-1">Berlin, Germany</dd>
    </div>
  </dl>

  <p class="mt-10 text-sm leading-relaxed max-w-2xl" style="color: var(--color-muted)">
    This site has no contact form. There is no server accepting input and no processing of
    form data.
  </p>
</Base>
