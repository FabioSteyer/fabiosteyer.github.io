---
import Base from '../../layouts/Base.astro';

const evidence = [
  { skill: 'Python (Pandas, NumPy)', proof: 'Production pipelines at Cavator, not public', level: 'used in practice' },
  { skill: 'Document parsing and OCR', proof: 'Invoice and quote reconciliation, ~3,000 documents', level: 'used in practice' },
  { skill: 'LLM integration (Claude, OpenAI)', proof: 'Built into my own pipelines in daily operation', level: 'used in practice' },
  { skill: 'Scientific data analysis', proof: 'B.Sc. thesis, spectroscopy and model fitting', level: 'publicly verifiable' },
  { skill: 'SQL', proof: 'University projects, still building', level: 'learning' },
  { skill: 'Git', proof: 'University projects and own work', level: 'learning' },
];
---

<Base
  lang="en"
  title="About — Fabio Steyer"
  description="Background, skills and the evidence behind them."
  altHref="/ueber-mich"
>
  <div class="sm:flex sm:items-start sm:gap-8">
    <div class="flex-1">
      <h1 class="text-3xl font-semibold tracking-tight">About</h1>
      <p class="mt-4 leading-relaxed">
        I am a physics master's student at TU Berlin and have worked since 2025 where data
        analysis meets process automation. What draws me to it is the decision before the code:
        which step needs a script, which needs a language model, and which is better left alone.
      </p>
    </div>
    <img
      src="/foto-fabio-steyer.jpg"
      alt="Portrait photograph of Fabio Steyer"
      width="160"
      height="210"
      class="mt-6 sm:mt-1 w-32 sm:w-40 rounded"
      loading="lazy"
    />
  </div>

  <section class="mt-14" aria-labelledby="evidence">
    <h2 id="evidence" class="text-xl font-semibold tracking-tight">Skills and evidence</h2>
    <p class="mt-3 leading-relaxed" style="color: var(--color-muted)">
      Each row states what it rests on. "Learning" means present, but not backed by a project.
    </p>
    <div class="mt-5 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="text-left border-b" style="border-color: var(--color-line)">
            <th class="py-2 pr-4 font-semibold">Skill</th>
            <th class="py-2 pr-4 font-semibold">Evidence</th>
            <th class="py-2 font-semibold">Level</th>
          </tr>
        </thead>
        <tbody>
          {evidence.map((e) => (
            <tr class="border-b align-top" style="border-color: var(--color-line)">
              <td class="py-2 pr-4">{e.skill}</td>
              <td class="py-2 pr-4" style="color: var(--color-muted)">{e.proof}</td>
              <td class="py-2 whitespace-nowrap">{e.level}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-14" aria-labelledby="ai">
    <h2 id="ai" class="text-xl font-semibold tracking-tight">On AI assistance</h2>
    <p class="mt-4 leading-relaxed">
      I work with AI tools, including while building this site. The technical decisions, the
      choice of content and its verification are mine.
    </p>
  </section>
</Base>
