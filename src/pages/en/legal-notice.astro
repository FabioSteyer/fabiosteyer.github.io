---
import Base from '../../layouts/Base.astro';
---

<Base
  lang="en"
  title="Legal notice — Fabio Steyer"
  description="Legal notice."
  altHref="/impressum"
>
  <h1 class="text-3xl font-semibold tracking-tight">Legal notice</h1>

  <section class="doc-section" aria-labelledby="responsible">
    <h2 id="responsible" class="doc-section__label">Responsible for the content</h2>
    <div class="doc-section__body">
      <p class="leading-relaxed">
        Fabio Steyer<br />
        <a href="mailto:steyerfabio@gmail.com">steyerfabio@gmail.com</a>
      </p>
    </div>
  </section>

  <section class="doc-section" aria-labelledby="purpose">
    <h2 id="purpose" class="doc-section__label">Purpose of this site</h2>
    <div class="doc-section__body">
      <p class="leading-relaxed">
        This is a private portfolio for professional self-presentation. It offers no goods
        or services, carries no advertising and serves no commercial purpose.
      </p>
    </div>
  </section>

  <section class="doc-section" aria-labelledby="content">
    <h2 id="content" class="doc-section__label">Content and links</h2>
    <div class="doc-section__body">
      <p class="leading-relaxed">
        The content of this site was compiled with care. The operators of linked external
        sites are responsible for their own content.
      </p>
      <p class="mt-4 leading-relaxed" style="color: var(--color-muted)">
        The German version of this page is authoritative.
      </p>
    </div>
  </section>
</Base>
