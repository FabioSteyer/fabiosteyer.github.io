---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
---

<Base
  lang="en"
  title="Projects — Fabio Steyer"
  description="Publicly verifiable projects with repository, runnable demo and tests."
  altHref="/projekte/"
>
  <h1 class="text-3xl font-semibold tracking-tight">Projects</h1>

  <p class="mt-4 leading-relaxed max-w-2xl">
    This page carries only what can be checked: source code, a runnable demo, tests, and
    instructions that get the project started in a few minutes. Both projects work on invented
    data only; nothing is carried over from previous employment.
  </p>

  {projects.map((project) => (
    <article class="project">
      <div class="project__head">
        <span class="project__repo">{project.repo}</span>
        <span class="project__stack">{project.stackEn}</span>
      </div>
      <h2 class="project__title">{project.en.title}</h2>

      <div class="project__body">
        <p class="leading-relaxed">{project.en.problem}</p>
        <p class="leading-relaxed">{project.en.approach}</p>
      </div>

      <div class="project__result">
        <span class="doc-meta-label">RESULT</span>
        <p class="leading-relaxed">{project.en.result}</p>
      </div>

      <div class="project__limits">
        <span class="doc-meta-label">WHAT IT DOES NOT SHOW</span>
        <p class="leading-relaxed">{project.en.notShown}</p>
      </div>

      <div class="project__links">
        <a href={project.url} rel="noopener noreferrer" aria-label={`View repository: ${project.repo}`}>View repository</a>
        <a href={`${project.url}#readme`} rel="noopener noreferrer" aria-label={`Decisions in the README: ${project.repo}`}>Decisions in the README</a>
      </div>
    </article>
  ))}

  <section class="doc-section" aria-labelledby="selection">
    <h2 id="selection" class="doc-section__label">On the selection</h2>
    <div class="doc-section__body">
      <p class="leading-relaxed">
        My process automation work was built inside a company and cannot be shown. Rather than
        describe it, I rebuilt two classes of problem from it — on invented data, with open
        instructions and tests that measure instead of claim.
      </p>
      <p class="mt-4 leading-relaxed" style="color: var(--color-muted)">
        Every entry states explicitly what the project does not show. Both READMEs document a
        mistake that only the measurement uncovered.
      </p>
    </div>
  </section>
</Base>
