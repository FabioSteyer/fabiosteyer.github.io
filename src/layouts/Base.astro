---
import '../styles/global.css';
import { nav, legalNav, strings, type Lang } from '../i18n/nav';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  altHref: string;
}

const { lang, title, description, altHref } = Astro.props;
const t = strings[lang];
const items = nav[lang];
const legal = legalNav[lang];
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const year = new Date().getFullYear();
const isActive = (href: string) => here === (href.replace(/\/+$/, '') || '/');

// Lighthouse verlangt fuer hreflang voll qualifizierte URLs und einen
// selbstbezueglichen Eintrag. Relative Pfade bestehen den Audit nicht.
const selfUrl = new URL(Astro.url.pathname, Astro.site).href;
const altUrl = new URL(altHref, Astro.site).href;
const altLang = lang === 'de' ? 'en' : 'de';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang={lang} href={selfUrl} />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={lang === 'de' ? selfUrl : altUrl} />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#inhalt" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-white focus:px-3 focus:py-2">{t.skip}</a>

    <header class="border-b" style="border-color: var(--color-line)">
      <div class="mx-auto max-w-3xl px-5 py-4 flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <a
          href={lang === 'de' ? '/' : '/en'}
          class="text-sm"
          style="font-family: var(--font-mono); font-weight: 500; letter-spacing: 0.01em"
        >{t.siteName}</a>
        <nav aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'} class="flex gap-5 text-sm">
          {items.map((i) => (
            <a
              href={i.href}
              aria-current={isActive(i.href) ? 'page' : undefined}
              class="nav-link"
            >{i.label}</a>
          ))}
        </nav>
        <a href={altHref} hreflang={lang === 'de' ? 'en' : 'de'} class="ml-auto text-sm hover:underline underline-offset-4" style="color: var(--color-muted)">{t.switch}</a>
      </div>
    </header>

    <main id="inhalt" class="mx-auto w-full max-w-3xl px-5 py-12 sm:py-16 flex-1">
      <slot />
    </main>

    <footer class="border-t mt-16" style="border-color: var(--color-line)">
      <div class="mx-auto max-w-3xl px-5 py-6 flex flex-wrap gap-x-5 gap-y-2 text-sm" style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-muted)">
        <span>&copy; {year} Fabio Steyer</span>
        {legal.map((i) => <a href={i.href} class="hover:underline underline-offset-4">{i.label}</a>)}
      </div>
    </footer>
  </body>
</html>
