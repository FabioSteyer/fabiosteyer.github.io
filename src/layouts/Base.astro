---
/**
 * Layout der Unterseiten (Ueber mich, Impressum, Datenschutz).
 *
 * Kopf- und Fusszeile sind dieselben Komponenten wie auf der Startseite
 * (SiteHeader, SiteFooter), damit der Wechsel zwischen One-Pager und
 * Unterseite kein Wechsel des Registers ist. Das Seitengeruest teilt sich
 * shell.css mit der Startseite; global.css traegt nur die Typografie und die
 * Dokumentmuster der Unterseiten.
 */
import '../styles/shell.css';
import '../styles/global.css';
import '../styles/transitions.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Lang } from '../data/portfolio';
import { variant } from '../variant';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  altHref: string;
  eyebrow?: string;
}

const { lang, title, description, altHref, eyebrow } = Astro.props;

// Lighthouse verlangt fuer hreflang voll qualifizierte URLs und einen
// selbstbezueglichen Eintrag. Relative Pfade bestehen den Audit nicht.
const selfUrl = new URL(Astro.url.pathname, Astro.site).href;
const altUrl = new URL(altHref, Astro.site).href;
const altLang = lang === 'de' ? 'en' : 'de';
---

<!doctype html>
<html lang={lang} data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang={lang} href={selfUrl} />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={lang === 'de' ? selfUrl : altUrl} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body class="page-body">
    <SiteHeader lang={lang} altHref={altHref} />
    <main id="inhalt" class="page wrap">
      {eyebrow && <p class="eyebrow page-eyebrow">{eyebrow}</p>}
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
